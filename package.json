{
  "name": "localinvoice",
  "version": "1.0.0",
  "description": "Offline GST Billing Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "build:mobile": "node build-mobile.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunal-gswm/LocalInvoice.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "astral-regex": "^2.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.localinvoice.app",
    "productName": "LocalInvoice",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "assets/logo.png",
      "lib/html2canvas.min.js",
      "lib/jspdf.umd.min.js",
      "lib/qrcode.min.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalInvoice"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4"
  }
}
